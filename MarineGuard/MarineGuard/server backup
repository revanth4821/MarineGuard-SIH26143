from flask import Flask, request, jsonify
from flask_cors import CORS
from PIL import Image
import io

app = Flask(__name__)
CORS(app)


@app.route("/")
def home():
    return "MarineGuard backend is running!"


@app.route("/analyze", methods=["POST"])
def analyze():

    if "image" not in request.files:
        return jsonify({
            "success": False,
            "message": "No image uploaded"
        }), 400

    image_file = request.files["image"]

    if image_file.filename == "":
        return jsonify({
            "success": False,
            "message": "No image selected"
        }), 400

    try:

        # Open uploaded image
        image = Image.open(image_file).convert("RGB")

        width, height = image.size

        # Resize for faster processing
        image.thumbnail((800, 800))

        pixels = list(image.getdata())

        total_pixels = len(pixels)

        dark_pixels = 0
        very_dark_pixels = 0

        total_brightness = 0

        # Analyze image pixels
        for r, g, b in pixels:

            brightness = (r + g + b) / 3

            total_brightness += brightness

            if brightness < 100:
                dark_pixels += 1

            if brightness < 70:
                very_dark_pixels += 1

        average_brightness = (
            total_brightness / total_pixels
        )

        dark_percentage = (
            dark_pixels / total_pixels
        ) * 100

        very_dark_percentage = (
            very_dark_pixels / total_pixels
        ) * 100

        # Candidate slick estimation
        if dark_percentage >= 35:
            slick_detected = True
            confidence = min(
                95,
                round(70 + dark_percentage * 0.5)
            )

        elif dark_percentage >= 15:
            slick_detected = True
            confidence = min(
                85,
                round(55 + dark_percentage * 0.8)
            )

        else:
            slick_detected = False
            confidence = max(
                20,
                round(45 - dark_percentage)
            )

        # Approximate affected area
        # Prototype estimate based on image coverage
        if slick_detected:
            area = round(
                max(1.0, dark_percentage * 0.20),
                2
            )
        else:
            area = 0

        result = {
            "success": True,
            "slick_detected": slick_detected,
            "confidence": confidence,
            "area": area,
            "location": "15.42°N, 73.81°E",
            "image_width": width,
            "image_height": height,
            "brightness": round(
                average_brightness,
                2
            ),
            "dark_percentage": round(
                dark_percentage,
                2
            ),
            "very_dark_percentage": round(
                very_dark_percentage,
                2
            )
        }

        return jsonify(result)

    except Exception as error:

        return jsonify({
            "success": False,
            "message": str(error)
        }), 500


if __name__ == "__main__":
    app.run(debug=True)
